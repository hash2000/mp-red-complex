/* ------------------------------------------------------------------
   Панель свойств: заголовок панели и редактор списка свойств.
   Редакторы значений получают имя объекта PropertyEditor и признак
   readOnlyEditor="true", когда свойство доступно только для чтения.
   ------------------------------------------------------------------ */

QLabel#PropertiesPanelHeader {
  font-weight: 600;
}

QLabel#PropertiesHeaderLabel {
  background: #2D2D30;
  color: #CCCCCC;
  padding: 6px 8px;
  font-weight: bold;
  border-bottom: 1px solid #3E3E42;
}

QScrollArea#PropertiesScroll {
  background: transparent;
  border: none;
}

QWidget#PropertiesContent {
  background: transparent;
}

QWidget#PropertiesContent QLabel {
  padding: 4px 6px;
  background: #252526;
  color: #D4D4D4;
  border-bottom: 1px solid #3E3E42;
}

QWidget#PropertyEditor {
  background: #1E1E1E;
  color: #D4D4D4;
  border: 1px solid #3E3E42;
  padding: 2px 4px;
  selection-background-color: #094771;
}

QWidget#PropertyEditor[readOnlyEditor="true"] {
  background: #252526;
  color: #808080;
  border: 1px solid transparent;
  selection-background-color: #555555;
}

QToolButton#PropertyBrowseButton {
  background: #3E3E42;
  color: white;
  border: none;
}
QToolButton#PropertyBrowseButton:pressed { background: #007ACC; }
QToolButton#PropertyBrowseButton:disabled { background: #333333; color: #666666; }

QWidget#PropertyContainer {
  background: transparent;
}

/* ------------------------------------------------------------------
   Группы панели свойств (PropertiesGroupWidget): заголовок-кнопка
   с треугольником и содержимое группы.
   ------------------------------------------------------------------ */

QWidget#PropertiesGroup {
  background: transparent;
}

QPushButton#PropertiesGroupHeader {
  background: #2d2d30;
  color: #cccccc;
  border: none;
  border-bottom: 1px solid #3e3e42;
  padding: 5px 8px;
  text-align: left;
  font-weight: 600;
}
QPushButton#PropertiesGroupHeader:hover { background: #37373d; }
QPushButton#PropertiesGroupHeader:checked { color: #ffffff; }

/* Подпись группы — отдельная метка внутри кнопки: всегда слева. */
QLabel#PropertiesGroupTitle {
  font-weight: 600;
}

QWidget#PropertiesGroupContent {
  background: transparent;
}

/* Цвет фона и текста кнопки выбора цвета задаются кодом (значение свойства),
   здесь — только рамка и отступы. */
QPushButton#PropertyColorButton {
  border: 1px solid #3E3E42;
  padding: 2px 6px;
  text-align: left;
}
QPushButton#PropertyColorButton:hover { border-color: #007ACC; }
QPushButton#PropertyColorButton:disabled { border-color: transparent; }

/* ------------------------------------------------------------------
   Редактор цвета вкладки (TabColorEditor): кнопка с образцом цвета
   и кнопка сброса. Цвет образца рисует код, рамку и отступы — тема.
   ------------------------------------------------------------------ */

QToolButton#TabColorButton {
  border: 1px solid #3E3E42;
  padding: 2px 6px;
  text-align: left;
}
QToolButton#TabColorButton:hover { border-color: #007ACC; }

QToolButton#TabColorReset {
  background: #3E3E42;
  color: white;
  border: none;
  padding: 2px 4px;
}
QToolButton#TabColorReset:hover { background: #007ACC; }
QToolButton#TabColorReset:disabled { background: #333333; color: #666666; }

/* ------------------------------------------------------------------
   Контекст документа: полное имя (только для чтения).
   Список переменных — PropertiesListWidget внутри вложенной группы.
   ------------------------------------------------------------------ */

QLineEdit#PropertiesContextName {
  background: #252526;
  color: #808080;
  border: 1px solid transparent;
  padding: 2px 4px;
  selection-background-color: #555555;
}

QToolButton#PropertiesContextCopy {
  background: #3E3E42;
  color: white;
  border: none;
  padding: 2px 6px;
}
QToolButton#PropertiesContextCopy:hover { background: #007ACC; }
