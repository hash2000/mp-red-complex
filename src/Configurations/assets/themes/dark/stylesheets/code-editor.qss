/* ------------------------------------------------------------------
   Редактор кода: CodeEditorWidget и панель поиска.
   Лента управления (DocumentRibbon, RibbonButton) оформляется общими
   правилами темы в base.qss.
   ------------------------------------------------------------------ */

CodeEditorWidget {
  background-color: #1e1e1e;
  color: #d4d4d4;
  border: 1px solid #3e3e42;
  border-radius: 3px;
}

/* ---------- Строка поиска (общая для редактора и просмотрщика) ---------- */
QWidget#CodeEditorSearchPanel {
  background-color: #252526;
}

QWidget#TextEditorSearchBar {
  background-color: #252526;
  border-bottom: 1px solid #3e3e42;
}

QLineEdit#TextEditorSearchInput {
  background-color: #1e1e1e;
  color: #d4d4d4;
  border: 1px solid #3e3e42;
  border-radius: 3px;
  padding: 2px 6px;
  min-height: 20px;
}
QLineEdit#TextEditorSearchInput:focus { border-color: #1177bb; }

QLabel#TextEditorSearchCount {
  color: #8f8f8f;
}

QToolButton#TextEditorSearchButton {
  color: #d4d4d4;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 3px;
  padding: 0px;
  min-width: 22px;
  min-height: 22px;
}
QToolButton#TextEditorSearchButton:hover { background-color: #3e3e42; }
QToolButton#TextEditorSearchButton:pressed { background-color: #094771; }

/* Параметры документа в панели «Свойства»: язык, шрифт, перенос строк. */
QComboBox#CodeEditorLanguageCombo,
QComboBox#CodeEditorFontSizeCombo,
QComboBox#CodeEditorLineWrapCombo,
QComboBox#EditorFontSizeCombo,
QComboBox#PagedHighlightingCombo,
QComboBox#EditorLineWrapCombo {
  background-color: #1e1e1e;
  color: #d4d4d4;
  border: 1px solid #3e3e42;
  border-radius: 3px;
  padding: 2px 6px;
  min-height: 22px;
}
QComboBox#CodeEditorLanguageCombo::drop-down,
QComboBox#CodeEditorFontSizeCombo::drop-down,
QComboBox#CodeEditorLineWrapCombo::drop-down,
QComboBox#EditorFontSizeCombo::drop-down,
QComboBox#PagedHighlightingCombo::drop-down,
QComboBox#EditorLineWrapCombo::drop-down { border: none; width: 16px; }
