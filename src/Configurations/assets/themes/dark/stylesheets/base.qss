/* ------------------------------------------------------------------
   Базовые стили темы: общие для приложения элементы управления.
   Файлы подключаются по порядку из stylesheets/index.yaml, поэтому
   специализированные наборы (console, properties, fetch-api, users)
   могут переопределять правила отсюда.
   ------------------------------------------------------------------ */

/* ---------- Общие кнопки ----------
   Правила действуют на все QToolButton, включая GlyphToolButton без своего
   objectName. Так внешний вид и размеры не зависят от системного стиля
   Windows; кнопки с собственным objectName переопределяют их ниже. */
QToolButton {
  color: #d4d4d4;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 3px;
  padding: 2px 6px;
}
QToolButton:hover   { background: #3c3c3c; border-color: #3c3c3c; }
QToolButton:pressed { background: #0e639c; border-color: #1177bb; }
QToolButton:checked { background: #094771; border-color: #1177bb; }
QToolButton:disabled { color: #666666; background: transparent; border-color: transparent; }
QToolButton::menu-indicator { image: none; }

/* ---------- Общие вкладки ----------
   QTabWidget в модулях (например, fetch-api) иначе рисуется системным
   стилем: на разных машинах получались светлые рамки и кнопки вкладок. */
QTabWidget::pane {
  border: 1px solid #3c3c3c;
  border-radius: 3px;
  background: #252526;
}
QTabBar::tab {
  background: #2d2d30;
  color: #9d9d9d;
  border: 1px solid #3c3c3c;
  border-bottom: none;
  padding: 4px 12px;
  margin-right: 1px;
}
QTabBar::tab:selected {
  background: #1f1f1f;
  color: #ffffff;
  border-top: 2px solid #7160e8;
}
QTabBar::tab:hover { color: #ffffff; }

/* ---------- Общие группы ---------- */
QGroupBox {
  border: 1px solid #3c3c3c;
  border-radius: 4px;
  margin-top: 10px;
  padding-top: 6px;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 8px;
  padding: 0 4px;
  color: #bbbbbb;
}

QTableView {
  border: none;
}

QListWidget {
  border: none;
}

QListWidget#controlListBox_listWidget {
  border: none;
}

QCheckBox#entityDefinition_checkboxWidget {
  margin-left: 11px;
}

QToolButton#toolButton_withBorder {
  border: 1 solid rgba(0, 0, 0, 50);
  border-radius: 3;
}

QToolButton#toolButton_withBorder::checked {
  background-color: rgba(0, 0, 0, 25);
}

tb--ui--BitmapButton {
  border: none;
}

tb--ui--BitmapButton::menu-indicator {
 image: none;
}

QToolTip { color:#cccccc; background:#252526; border:1px solid #3c3c3c; padding:3px; }

QMenuBar { background:#1f1f1f; }
QMenuBar::item { padding:4px 10px; background:transparent; }
QMenuBar::item:selected { background:#3c3c3c; border-radius:4px; }
QMenu { background:#252526; border:1px solid #3c3c3c; padding:4px; }
QMenu::item { padding:4px 24px 4px 20px; border-radius:3px; }
QMenu::item:selected { background:#7160e8; color:white; }
QMenu::separator { height:1px; background:#3c3c3c; margin:4px 8px; }

QStatusBar { background:#7160e8; color:white; }
QStatusBar QLabel { color:white; padding:0 6px; }

QSplitter::handle { background:#2b2b2b; }
QSplitter::handle:hover { background:#7160e8; }

QScrollArea { border:none; background:transparent; }
QTreeView, QPlainTextEdit, QTableWidget { border:none; }
QHeaderView::section { background:#252526; color:#cccccc; border:none;
                       border-right:1px solid #2b2b2b; padding:3px 6px; }

QLineEdit, QSpinBox { background:#313131; border:1px solid #3c3c3c; border-radius:3px; padding:2px 4px; }
QLineEdit:focus, QSpinBox:focus { border:1px solid #7160e8; }
QPushButton { background:#313131; border:1px solid #3c3c3c; border-radius:3px; padding:4px 12px; }
QPushButton:hover { background:#3c3c3c; }

/* ---------- Общие выпадающие списки ---------- */
QComboBox {
  background:#313131;
  color:#d4d4d4;
  border:1px solid #3c3c3c;
  border-radius:3px;
  padding:2px 6px;
  min-height:20px;
}
QComboBox:hover { border-color:#7160e8; }
QComboBox QAbstractItemView {
  background:#252526;
  color:#d4d4d4;
  border:1px solid #3c3c3c;
  selection-background-color:#7160e8;
  selection-color:#ffffff;
}

/* ---------- Общие индикаторы выполнения ---------- */
QProgressBar {
  background:#313131;
  border:1px solid #3c3c3c;
  border-radius:3px;
  text-align:center;
}
QProgressBar::chunk { background:#7160e8; border-radius:2px; }

/* ---------- Общие заголовки панелей ---------- */
#PanelHeader { background:#181818; border-bottom:1px solid #2b2b2b; }
#PanelTitle  { color:#bbbbbb; font-weight:600; }
#PanelCounter{ color:#808080; }
QToolButton#HeaderButton { border:none; border-radius:4px; padding:2px 4px;
                           min-width:20px; background:transparent; color:#cccccc; }
QToolButton#HeaderButton:hover   { background:#3c3c3c; }
QToolButton#HeaderButton:checked { background:#3a3550; color:#ffffff; }

/* ---------- Левая панель вкладок ---------- */
#DocumentTabsPanel { background:#181818; border-right:1px solid #2b2b2b; }
#DocumentTabsList  { background:#181818; }
#DocumentTabItem   { background:transparent; border-radius:4px; border-left:2px solid transparent; }
#DocumentTabItem:hover { background:#2a2d2e; }
#DocumentTabItem[active="true"] { background:#37373d; border-left:2px solid #7160e8; }
#DocumentTabItem QLabel { background:transparent; }
#DocTabTitle[modified="true"] { font-style:italic; }
QToolButton#DocTabButton { border:none; border-radius:3px; background:transparent;
                           padding:0px; min-width:18px; min-height:18px; color:#cccccc; }
QToolButton#DocTabButton:hover { background:#4a4a50; color:white; }

/* Перетаскивание вкладок: место вставки и переносимая вкладка. */
#DocumentTabItem[drop="before"] { border-top:2px solid #7160e8; }
#DocumentTabItem[drop="after"]  { border-bottom:2px solid #7160e8; }
#DocumentTabItem[dragging="true"] { background:#2a2d2e; color:#9d9d9d; }

/* Заголовок группы вкладок (группировка по цвету или типу). */
#DocumentTabsGroup { color:#808080; font-weight:600; padding:6px 6px 2px 6px; }

/* ---------- Лента документа (DocumentRibbon / RibbonButton) ---------- */
QWidget#DocumentRibbon {
  background-color: #252526;
  border-bottom: 1px solid #3e3e42;
}

QFrame#RibbonGroup {
  background-color: #2d2d30;
  border: 1px solid #3e3e42;
  border-radius: 4px;
}

QLabel#RibbonGroupCaption {
  color: #8f8f8f;
  font-size: 8px;
  font-weight: 600;
}

QToolButton#RibbonButtonMain {
  color: #d4d4d4;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 3px;
  font-size: 15px;
  padding: 0px;
}
QToolButton#RibbonButtonMain:hover { background-color: #094771; border-color: #1177bb; }
QToolButton#RibbonButtonMain:pressed { background-color: #0e639c; }
QToolButton#RibbonButtonMain:checked { background-color: #0e639c; border-color: #1177bb; }

/* Значок «свойства» в правом нижнем углу кнопки ленты. */
QToolButton#RibbonButtonProperties {
  color: #ffffff;
  background-color: #0e639c;
  border: none;
  border-radius: 6px;
  font-size: 8px;
  padding: 0px;
}
QToolButton#RibbonButtonProperties:hover { background-color: #1177bb; }
QToolButton#RibbonButtonProperties:pressed { background-color: #094771; }

QToolButton#RibbonToggle {
  color: #8f8f8f;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 3px;
  font-size: 11px;
  padding: 0px;
}
QToolButton#RibbonToggle:hover { color: #d4d4d4; background-color: #3e3e42; }

/* ---------- Центральная область ---------- */
#DocumentArea, #EmptyPage { background:#1f1f1f; }
#EmptyHint { color:#6e6e6e; font-size:13pt; }

/* ---------- Activity Bar (справа) ---------- */
#ActivityBar { background:#181818; border-left:1px solid #2b2b2b; }
#ActivityBar[collapsed="true"] { background:#2b2b2b; }
#ActivityBar[collapsed="true"]:hover { background:#7160e8; }
QToolButton#ActivityButton { border:none; border-left:2px solid transparent; background:transparent;
                             font-size:18px; color:#858585; min-height:44px; padding:0px; }
QToolButton#ActivityButton:hover   { color:#ffffff; }
QToolButton#ActivityButton:checked { color:#ffffff; border-left:2px solid #7160e8; background:#252526; }

/* Кнопка сворачивания панели кнопок. Глобальный padding QToolButton
   (2px 6px) не оставляет места стрелке в кнопке шириной 14 px. */
QToolButton#pinButton { padding:0px; border:none; }
/* Маленькая кнопка автоскрытия в полоске вкладок BottomPanel. */
QToolButton#bottomPinButton { padding:0px; border:none; }

/* ---------- Боковая и нижняя панели ---------- */
#SideHostPanel { background:#181818; }
#BottomPanel   { background:#181818; border-top:1px solid #2b2b2b; }
QTabBar#BottomTabs { background:#181818; }
QTabBar#BottomTabs::tab { background:transparent; color:#9d9d9d; padding:4px 12px;
                          border:none; border-top:2px solid transparent; }
QTabBar#BottomTabs::tab:selected { color:#ffffff; border-top:2px solid #7160e8; background:#1f1f1f; }
QTabBar#BottomTabs::tab:hover { color:#ffffff; }

/* ---------- Чекбоксы ---------- */
QCheckBox { color:#d4d4d4; spacing:6px; }
QCheckBox::indicator {
  width:14px; height:14px;
  border:1px solid #6b6b6b; border-radius:2px;
  background:#1e1e1e;
}
QCheckBox::indicator:hover { border-color:#1177bb; }
QCheckBox::indicator:checked { background:#1177bb; border-color:#1177bb; }
QCheckBox::indicator:disabled { border-color:#3e3e42; background:#252526; }

/* ---------- Индикатор фоновых задач ---------- */
QLabel#BackgroundTasksIndicatorLabel { color:#d4d4d4; padding:0px 6px; }
