/* ------------------------------------------------------------------
   Модуль FetchApi: панель запроса и ответа.
   Состояние индикатора и метки статуса задаётся динамическим свойством
   state ("success" / "error"). Параметры отправки (тип запроса и TLS)
   редактируются в панели «Свойства» и оформляются общими правилами.
   ------------------------------------------------------------------ */

QComboBox#FetchMethodCombo {
  padding: 5px;
  font-weight: bold;
}

QComboBox#FetchAuthTypeCombo,
QComboBox#FetchAuthAddToCombo {
  padding: 5px;
}

QLineEdit#FetchUrlEdit {
  padding: 8px;
  border: 1px solid #ccc;
  border-radius: 4px;
}

QLineEdit#FetchAuthNameEdit,
QLineEdit#FetchAuthValueEdit {
  padding: 4px 6px;
  border: 1px solid #4a5568;
  border-radius: 3px;
}

QLabel#FetchTime,
QLabel#FetchSize {
  color: #a0aec0;
}

QPlainTextEdit#FetchBodyEdit {
  background-color: #2D2D2D;
  color: #F8F8F2;
  border: 1px solid #444;
}

/* Ответ отображается в простом текстовом поле (QPlainTextEdit):
   подсветка синтаксиса модулю не нужна. */
QPlainTextEdit#FetchResponseBody {
  background-color: #2D2D2D;
  color: #F8F8F2;
  border: 1px solid #444;
}

QProgressBar#FetchProgress {
  border: 1px solid #2d3748;
  border-radius: 3px;
  background-color: #4a5568;
}
QProgressBar#FetchProgress::chunk {
  background-color: #FF6C37;
  border-radius: 2px;
}
QProgressBar#FetchProgress[state="error"] {
  border: 1px solid #ccc;
  background-color: #f0f0f0;
}
QProgressBar#FetchProgress[state="error"]::chunk {
  background-color: #FF4D4D;
  border-radius: 2px;
}

QLabel#FetchStatus[state="success"] { color: green; font-weight: bold; }
QLabel#FetchStatus[state="error"]   { color: red;   font-weight: bold; }
